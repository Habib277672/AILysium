DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ailysium?schema=public"

PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

JWT_ACCESS_SECRET="replace-with-a-long-random-string"

RESEND_API_KEY="re_replace_with_real_key"
RESEND_FROM_EMAIL="AiLysium <onboarding@resend.dev>"

# Admin bootstrap — this account is auto-created on server startup if it
# doesn't already exist. Login normally via POST /api/auth/login with
# these credentials once the server has started at least once.
ADMIN_EMAIL="admin@ailysium.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_FULL_NAME="AiLysium Admin"
ADMIN_PHONE_NUMBER="+10000000000"